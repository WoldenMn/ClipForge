{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClipForge",
  "version": "1.0.0",
  "identifier": "com.clipforge.app",
  "build": {
    "frontendDist": "splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ClipForge",
        "url": "http://127.0.0.1:8765",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "visible": false,
        "center": true
      },
      {
        "label": "splashscreen",
        "title": "ClipForge",
        "url": "splash.html",
        "width": 480,
        "height": 260,
        "decorations": false,
        "center": true,
        "resizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
